{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 340,

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "data": {
    "url": "data/chart4_slope.csv"
  },

  "transform": [
    {
      "fold": [
        "index_2010",
        "index_2020"
      ],
      "as": [
        "period",
        "index"
      ]
    },
    {
      "calculate": "datum.period === 'index_2010' ? '2010-11' : '2020-21'",
      "as": "year"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2010-11",
            "2020-21"
          ],
          "axis": {
            "title": null,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "labelPadding": 10,
            "ticks": false,
            "domain": false
          }
        },

        "y": {
          "field": "index",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              140
            ]
          },
          "axis": {
            "title": "Relative land area (2010-11 = 100)",
            "titleFontSize": 13,
            "labelFontSize": 11,
            "grid": true,
            "gridColor": "#E6E6E6",
            "domain": false
          }
        },

        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grazing",
              "Cropping",
              "Horticulture",
              "Intensive agriculture"
            ],
            "range": [
              "#AAB88A",
              "#E2C66D",
              "#C68E6B",
              "#C28A9D"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "activity"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2010-11",
            "2020-21"
          ]
        },

        "y": {
          "field": "index",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              140
            ]
          }
        },

        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grazing",
              "Cropping",
              "Horticulture",
              "Intensive agriculture"
            ],
            "range": [
              "#AAB88A",
              "#E2C66D",
              "#C68E6B",
              "#C28A9D"
            ]
          },
          "legend": null
        },

        "tooltip": [
          {
            "field": "activity",
            "title": "Activity"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "index",
            "title": "Index",
            "format": ".1f"
          },
          {
            "field": "area_2010_mha",
            "title": "2010-11 area (M ha)",
            "format": ".3f"
          },
          {
            "field": "area_2020_mha",
            "title": "2020-21 area (M ha)",
            "format": ".3f"
          },
          {
            "field": "change_mha",
            "title": "Net change (M ha)",
            "format": "+.3f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year === '2020-21'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": "bold"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2010-11",
            "2020-21"
          ]
        },

        "y": {
          "field": "index",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              140
            ]
          }
        },

        "text": {
          "field": "activity"
        },

        "color": {
          "field": "activity",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grazing",
              "Cropping",
              "Horticulture",
              "Intensive agriculture"
            ],
            "range": [
              "#66704D",
              "#9A7D17",
              "#955D43",
              "#8D5C6D"
            ]
          },
          "legend": null
        }
      }
    }
  ],

  "config": {
    "background": "white",
    "font": "DM Sans",
    "view": {
      "stroke": null
    }
  }
}